{
  "manifest_version": 3,
  "name": "Maskly",
  "version": "0.1.0",
  "description": "Local-first privacy protection for browser-based AI conversations.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background.js" },
  "action": { "default_title": "Maskly", "default_popup": "src/popup.html" },
  "options_page": "src/options.html",
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["src/bridge.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_idle", "world": "ISOLATED" }
  ],
  "commands": {
    "protect-selection": {
      "suggested_key": { "default": "Ctrl+Shift+P", "mac": "Command+Shift+P" },
      "description": "Protect the focused input with Maskly"
    }
  }
}
